# ═══════════════════════════════════════════
# Moiz AI Portfolio Backend — Environment Config
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ═══════════════════════════════════════════

# ─── AI Provider ───────────────────────────
# Supported: google | openai | anthropic
AI_PROVIDER=google

# ─── API Key ───────────────────────────────
# Google Gemini: Get from https://aistudio.google.com/app/apikey
# OpenAI: Get from https://platform.openai.com/api-keys
# Anthropic: Get from https://console.anthropic.com/
AI_API_KEY=your_api_key_here

# ─── Server ────────────────────────────────
PORT=5000
DEBUG=false

# ─── Security ──────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: https://moizasif484.github.io,http://localhost:8080
# Use * to allow all (development only)
ALLOWED_ORIGINS=*

# ─── Optional Contact Notification ─────────
# If you want email notifications for contact form
# (requires flask-mail or similar setup)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@email.com
# MAIL_PASSWORD=your_app_password
# MAIL_TO=your@email.com
